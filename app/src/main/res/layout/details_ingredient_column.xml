<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/detalis_item_bg"
    android:padding="20dp"
    android:layout_margin="6dp"
    android:maxHeight="150dp"
    android:maxWidth="100dp"

    >


    <ImageView
        android:id="@+id/IngredientsImage"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_centerHorizontal="true"

        android:background="@drawable/rounded_image"
        app:srcCompat="@drawable/ic_cooking_pot" />

    <TextView
        android:id="@+id/IngredientsName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/always_black"
        android:layout_below="@+id/IngredientsImage"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="IngredientsName"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/IngredientsMeasure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/IngredientsName"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:textColor="@color/always_black"
        android:text="IngredientsMeasure"
        android:textSize="12sp" />
</RelativeLayout>